{
  "openapi": "3.1.0",
  "info": {
    "title": "一加AI中台下游接入最小契约",
    "version": "2026-11-24",
    "description": "Login, managed key bootstrap, model catalog, live quota and chat only. The running controllers are authoritative. Local model responses use WireMock."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18081",
      "description": "Local unified entry"
    }
  ],
  "paths": {
    "/console/platform/auth/login": {
      "post": {
        "operationId": "passwordLogin",
        "description": "Existing account password login. Desktop Web session context is inferred by the existing device/user-agent protocol.",
        "parameters": [
          {
            "name": "X-Device-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          },
          {
            "name": "User-Agent",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Desktop Web user agent for this integration path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "identifier",
                  "password"
                ],
                "properties": {
                  "identifier": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "accessToken"
                  ],
                  "properties": {
                    "accessToken": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid login request"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "429": {
            "description": "Login rate limit"
          }
        }
      }
    },
    "/console/gateway/client/bootstrap": {
      "post": {
        "operationId": "bootstrapManagedKey",
        "security": [
          {
            "PlatformToken": []
          }
        ],
        "description": "Requires DESKTOP_WEB session, matching validated device and active package. No manual key creation.",
        "parameters": [
          {
            "name": "X-Device-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          },
          {
            "name": "usageDimension",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "TOKEN",
                "IMAGE",
                "VIDEO_SECOND",
                "AUDIO_SECOND"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "apiBaseUrl",
                    "apiKey",
                    "allowedModels",
                    "usageDimension"
                  ],
                  "properties": {
                    "apiBaseUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "apiKey": {
                      "type": "string"
                    },
                    "packageInstanceId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "packageCode": {
                      "type": "string"
                    },
                    "packageExpiresAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "allowedModels": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "usageDimension": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid session or device",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapError"
                }
              }
            }
          },
          "422": {
            "description": "Active package required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapError"
                }
              }
            }
          },
          "429": {
            "description": "Bootstrap rate limited; Retry-After is provided",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapError"
                }
              }
            }
          },
          "503": {
            "description": "Bootstrap temporarily unavailable"
          }
        }
      }
    },
