# Nginx 入口
NGINX_PORT=18081

# 嵌入到 Web 控制台构建产物里的公开 OpenAI 兼容端点。
VITE_API_BASE_URL=http://8.138.108.191/v1
# 作为桌面客户端的 Bootstrap apiBaseUrl 下发。必须保证运行桌面应用的机器能访问到它：
# 本地联调时使用回环地址（.env），真实部署时使用公开的 HTTPS 基址。
# 它还必须与桌面端 OAuth base URL 同源，否则客户端会以 bootstrap_api_base_url_untrusted
# 为由拒绝它，并且永远不会回显账号套餐信息。
# 未打包的桌面构建始终使用 http://127.0.0.1:18081
# 因此本地联调这里必须用 127.0.0.1 —— 像 192.168.x.x 这样的局域网 IP 不会匹配。
GATEWAY_CLIENT_API_BASE_URL=http://127.0.0.1:18081/v1

# 技能/专家目录。以数据库为准；只有需要显式回滚到旧的只读目录时才设为 filesystem。
GATEWAY_SKILLS_SOURCE=database
GATEWAY_SKILLS_MAX_FILE_BYTES=1048576
GATEWAY_SKILLS_MAX_TOTAL_BYTES=4194304
GATEWAY_SKILLS_MAX_FILES_PER_SKILL=64
# Compose 把这两个值直接映射到 clamd 的 StreamMaxLength/MaxFileSize 与
# MaxScanSize，因此网关与扫描器只有一个事实来源。
GATEWAY_SKILLS_MAX_PACKAGE_BYTES=209715200
GATEWAY_SKILLS_FILESYSTEM_ARCHIVE_CACHE_MAX_ENTRIES=64
GATEWAY_SKILLS_FILESYSTEM_ARCHIVE_CACHE_MAX_BYTES=64MB
GATEWAY_SKILLS_FILESYSTEM_DOWNLOAD_MAX_SESSIONS=1000
GATEWAY_SKILLS_FILESYSTEM_DOWNLOAD_MAX_ARCHIVE_BYTES=512MB
GATEWAY_SKILLS_MAX_EXTRACTED_BYTES=524288000
GATEWAY_SKILLS_MAX_PACKAGE_ENTRIES=2000
GATEWAY_SKILLS_MIN_COMPRESSION_RATIO=100
GATEWAY_SKILLS_ICON_MAX_BYTES=4194304
GATEWAY_SKILLS_DELETED_RETENTION=30d
GATEWAY_SKILLS_DOWNLOAD_SESSION_TTL=24h
GATEWAY_SKILLS_LOG_RETENTION=90d
GATEWAY_SKILLS_DOWNLOAD_LIMIT=10
GATEWAY_SKILLS_DOWNLOAD_WINDOW=1m
GATEWAY_SKILLS_DOWNLOAD_RATE_LIMIT_TIMEOUT=1s
GATEWAY_SKILLS_CLEANUP_BATCH_SIZE=500
GATEWAY_SKILLS_CLEANUP_MAX_DOWNLOAD_BATCHES=20
GATEWAY_SKILLS_CLEANUP_DELAY_MS=3600000
GATEWAY_SKILLS_CLEANUP_INITIAL_DELAY_MS=3600000

# 可选的分布式链路追踪。只有在准备好 OTLP HTTP collector 之后才启用。
OTEL_TRACING_ENABLED=false
OTEL_HEAD_SAMPLING_PROBABILITY=0.1
OTEL_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces

# 本地 PostgreSQL 与应用角色
POSTGRES_PASSWORD=local-postgres-password
PLATFORM_DB_PASSWORD=local-platform-password
GATEWAY_DB_PASSWORD=local-gateway-password

# 本地 Redis
REDIS_PASSWORD=local-redis-password

# 本地 MinIO 与文件存储
MINIO_ROOT_USER=local-minio-admin
MINIO_ROOT_PASSWORD=local-minio-password
STORAGE_FILES_BUCKET=api-model-platform-local
STORAGE_FILES_REGION=us-east-1

# 共享的认证与加密配置。
#
# 这些是必填项（compose.yaml 没有为它们提供兜底值），下面的值只是占位符，用来让
# `docker compose config` 能渲染出来。只要不是用完即弃的本地环境，启动之前都要自己生成，例如
#   SECURITY_INTERNAL_HMAC_SECRET -> openssl rand -hex 32
#   SECURITY_API_KEY_PEPPER       -> openssl rand -hex 32
#   GATEWAY_SECRETS_ENCRYPTION_KEY-> openssl rand -base64 32
#   LOGIN_RISK_PEPPER             -> openssl rand -hex 32
# 若加密密钥解码后不是恰好 32 字节，网关会拒绝启动；
# 历史上一度提交进仓库的那些值也会被直接拒绝。
SECURITY_JWT_ACTIVE_KEY_ID=local-platform-active
SECURITY_JWT_ISSUER=yuzhihuihe-local
SECURITY_INTERNAL_HMAC_SECRET=replace-me-with-openssl-rand-hex-32
SECURITY_API_KEY_PEPPER=replace-me-with-openssl-rand-hex-32
GATEWAY_SECRETS_ENCRYPTION_KEY=cmVwbGFjZS1tZS13aXRoLTMyLXJhbmRvbS1ieXRlcyE=
# 必填：生成一个仅由网关与转换器共享的私有随机令牌。
DOCUMENT_CONVERTER_AUTH_TOKEN=

# 内容安全使用专用的语义审核凭证与 ClamAV 服务。
#
# ⚠️ 下面这组 MOCK 值**只允许出现在本地/自动化测试环境**。
# 语义审核 MOCK 不是"降级"，而是**完全不审核**：`MockSemanticSafetyProvider`
# 除两个测试用字面量外一律返回 allow，此时文本侧只剩 5 条硬编码短语。
#
# 供参考的护栏（在代码里，不在本文件里）：想用 MOCK 必须**同时**满足
#   1) CONTENT_SAFETY_SEMANTIC_ALLOW_MOCK=true
#   2) SPRING_PROFILES_ACTIVE 的每一个 profile 都属于 {local, test}
# 任一不满足 → 网关**拒绝启动**（`content_safety_mock_provider_not_allowed`），
# 因此生产不会"静默"跑在 MOCK 上——它根本起不来。
#
# 若不希望本文件同时充当"契约基线"，见 deploy/tests/deployment-contract.test.mjs:729
# （该测试断言本文件的 ALLOW_MOCK=true，即本文件被有意当成"本地样例"）。
CONTENT_SAFETY_ENABLED=true
CONTENT_SAFETY_FAIL_CLOSED=true
CONTENT_SAFETY_SEMANTIC_PROVIDER=MOCK
CONTENT_SAFETY_SEMANTIC_BASE_URL=http://wiremock:8080
CONTENT_SAFETY_SEMANTIC_ALLOW_MOCK=true
CONTENT_SAFETY_SEMANTIC_CREDENTIAL=local-content-safety-only
CONTENT_SAFETY_CLAMAV_ENABLED=true
CONTENT_SAFETY_CLAMAV_HOST=clamav
CONTENT_SAFETY_CLAMAV_PORT=3310
CONTENT_SAFETY_CLAMAV_CONNECT_TIMEOUT=2s
CONTENT_SAFETY_CLAMAV_READ_TIMEOUT=10m

# 确定性的本地管理员。口令是必填项（没有提交进仓库的默认值），而本地引导只会在该账号还没有
# 口令时写入它，因此运维轮换过的口令能扛过重新部署。
LOCAL_ADMIN_EMAIL=admin@local.test
LOCAL_ADMIN_PASSWORD=replace-me-with-a-local-admin-password

# 服务条款与隐私政策同意的兜底版本号，仅在还没有任何已发布文档时使用。权威版本是
# platform.legal_document_version 中已发布的那一行，在「管理控制台 → 协议管理」中编辑。
PLATFORM_CONSENT_VERSION=2026-09-15

# 第二阶段支付渠道。在运维自有的环境中提供沙箱或生产凭证之前，真实渠道一直保持关闭。
#
# PAYMENT_MOCK_ENABLED 在 compose.yaml 中默认为 false。只有本地开发才应把它设为 true。
# 模拟支付过去是始终开启的，并且用内部 HMAC 密钥当回调密钥，
# 这让未认证的调用方就能把订单标记为已支付。
PAYMENT_MOCK_ENABLED=true
PAYMENT_MOCK_CALLBACK_SECRET=replace-me-with-a-secret-different-from-the-internal-hmac
PAYMENT_WECHAT_PAY_ENABLED=false
PAYMENT_WECHAT_PAY_APP_ID=
PAYMENT_WECHAT_PAY_MERCHANT_ID=
PAYMENT_WECHAT_PAY_MERCHANT_PRIVATE_KEY_RESOURCE=
PAYMENT_WECHAT_PAY_API_V3_KEY=
PAYMENT_WECHAT_PAY_CERTIFICATE_SERIAL=
PAYMENT_WECHAT_PAY_PLATFORM_PUBLIC_KEY_RESOURCE=
PAYMENT_WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
PAYMENT_WECHAT_PAY_NOTIFY_URL=
PAYMENT_WECHAT_PAY_CONNECT_TIMEOUT=3s
PAYMENT_WECHAT_PAY_READ_TIMEOUT=10s
PAYMENT_WECHAT_PAY_TOTAL_OPERATION_TIMEOUT=15s

PAYMENT_ALIPAY_ENABLED=false
PAYMENT_ALIPAY_APP_ID=
PAYMENT_ALIPAY_APPLICATION_PRIVATE_KEY_RESOURCE=
PAYMENT_ALIPAY_ALIPAY_PUBLIC_KEY_RESOURCE=
PAYMENT_ALIPAY_SELLER_ID=
PAYMENT_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
PAYMENT_ALIPAY_NOTIFY_URL=
PAYMENT_ALIPAY_RETURN_URL=
PAYMENT_ALIPAY_CHARSET=UTF-8
PAYMENT_ALIPAY_SIGN_TYPE=RSA2
PAYMENT_ALIPAY_CONNECT_TIMEOUT=3s
PAYMENT_ALIPAY_READ_TIMEOUT=10s
PAYMENT_ALIPAY_TOTAL_OPERATION_TIMEOUT=15s

# 商业化交易任务与有界对账输入。
PAYMENT_ORDER_EXPIRY=15m
PAYMENT_JOBS_BATCH_SIZE=50
PAYMENT_JOBS_CLAIM_TIMEOUT=30s
PAYMENT_JOBS_INITIAL_BACKOFF=5s
PAYMENT_JOBS_MAX_BACKOFF=1h
PAYMENT_JOBS_MAX_ATTEMPTS=12
PAYMENT_JOBS_EXPIRED_ORDER_DELAY_MS=5000
PAYMENT_JOBS_RECHARGE_EXPIRY_DELAY_MS=5000
PAYMENT_JOBS_COMPENSATION_DELAY_MS=5000
REFUND_JOBS_PREPARATION_DELAY_MS=5000
REFUND_JOBS_COMPENSATION_DELAY_MS=10000
REFUND_JOBS_BATCH_SIZE=50
REFUND_JOBS_CLAIM_TIMEOUT=30s
REFUND_JOBS_INITIAL_BACKOFF=5s
REFUND_JOBS_MAX_BACKOFF=1h
REFUND_JOBS_MAX_ATTEMPTS=12
REFUND_PROVIDER_NOTIFY_URL=https://localhost/console/platform/refunds/wechat-pay/callback
RECONCILIATION_JOB_ENABLED=true
RECONCILIATION_DAILY_CRON=0 30 2 * * *
RECONCILIATION_ZONE=Asia/Shanghai
RECONCILIATION_MAX_BILL_BYTES=52428800
RECONCILIATION_MAX_RECORDS=1000000

# 可重入的经营台账回填。每个来源各自维护独立的元组游标。
OPERATING_BACKFILL_BATCH_SIZE=500
OPERATING_BACKFILL_FIXED_DELAY_MS=60000

# 连续包月自动续费：核对存量订阅后才开启调度，默认不扣款。
#
# SUBSCRIPTION_JOBS_ENABLED 的默认值是 false，这是刻意的：上线顺序必须是
# 「迁移 → 后端 → 前端 → 打开调度」。默认开启会在存量订阅还没被核对之前就开始扣款。
#
# CHARGE_LEAD_TIME 是到期前多久扣款。默认 24h 而不是 0：
#   1. 它把「余额不足 → 充值」的窗口落在用户察觉服务中断之前；
#   2. 续期实例以 QUEUED 落库、有效期从**激活时刻**起算（不是扣款时刻），
#      因此提前扣款不会浪费用户已付的时长。
#
# PRICE_INCREASE_REQUIRES_CONFIRMATION 必须是 true——自动续费不得在用户
# 未获通知的情况下按新价扣款，这是合规要求，不是可调项。
#
# 这条不只是注释：把它设成 false 而当前 profile 又不在下面的允许列表里时，
# platform-service **会直接拒绝启动**（由 SubscriptionComplianceStartupCheck 在启动期校验；放在懒加载的调度组件里不会生效）。
# 这样配置错误会在启动时响亮地暴露，而不是变成「静默按新价扣款、没人发现」。
# 允许覆盖的 profile 由 PRICE_INCREASE_OVERRIDE_ALLOWED_PROFILES 控制，默认仅供本地/测试。
SUBSCRIPTION_JOBS_PRICE_INCREASE_OVERRIDE_ALLOWED_PROFILES=local,test,integration
#
# STUCK_QUEUED_ALERT_AFTER 是「扣款成功但权益长期未生效」的兜底阈值。
# 这是本功能唯一会静默吞钱的路径：钱扣了、服务没生效、用户收不到失败通知。
SUBSCRIPTION_JOBS_ENABLED=false
SUBSCRIPTION_JOBS_BATCH_SIZE=50
SUBSCRIPTION_JOBS_RENEWAL_DELAY_MS=60000
SUBSCRIPTION_JOBS_CLAIM_TIMEOUT=5m
SUBSCRIPTION_JOBS_INITIAL_BACKOFF=1h
SUBSCRIPTION_JOBS_MAX_BACKOFF=24h
SUBSCRIPTION_JOBS_MAX_ATTEMPTS=3
SUBSCRIPTION_JOBS_GRACE_PERIOD=7d
SUBSCRIPTION_JOBS_CHARGE_LEAD_TIME=24h
SUBSCRIPTION_JOBS_MAX_RENEWALS=36
SUBSCRIPTION_JOBS_STUCK_QUEUED_ALERT_AFTER=45d
SUBSCRIPTION_JOBS_PRICE_INCREASE_REQUIRES_CONFIRMATION=true

# 涨价报价待用户确认的时限：超过它仍未确认就终止订阅（设计 §7.3 的兜底）。
# 没有这条兜底，订阅会无限期停在「ACTIVE 但永不扣款」——用户以为在续费、实际早已停止，
# 而且暂缓刻意不发失败通知，因此不会有任何一方收到告警。
#
# 下限 24h，由代码强制（设更短会让服务拒绝启动）。依据是流程时序：扣款发生在周期结束前
# CHARGE_LEAD_TIME（默认 24h），用户**在扣款之后**仍需要一段可回应的时间。低于一天，
# 等于把「用户没来得及看通知」变成「订阅被终止」——而且是静默终止。
SUBSCRIPTION_JOBS_PRICE_CONFIRMATION_TIMEOUT=30d

# 登录风控隐私。LOGIN_RISK_PEPPER 必须是强且唯一的密钥，长度至少 32 个字符；绝不要复用其他密钥。
# 下面两个值都是 compose.yaml 的必填项（`${VAR:?}`）：生成它们属于首次部署的一部分。
#   LOGIN_RISK_PEPPER                 -> openssl rand -hex 32
#   PASSWORD_LOGIN_RATE_LIMIT_HMAC_KEY -> openssl rand -hex 32   (>= 32 bytes)
# 以前把任一值留空，都会让服务用本仓库里公开的 pepper 去给登录设备做指纹，因为默认 profile 是 local。
# 启动之前请用 deploy/geoip/download-ip2region.ps1 准备好两个 XDB 文件。
LOGIN_RISK_PEPPER=replace-me-with-openssl-rand-hex-32
PASSWORD_LOGIN_RATE_LIMIT_HMAC_KEY=replace-me-with-openssl-rand-hex-32
PASSWORD_LOGIN_ACCOUNT_LIMIT=5
PASSWORD_LOGIN_ACCOUNT_WINDOW=15m
PASSWORD_LOGIN_IP_LIMIT=20
PASSWORD_LOGIN_IP_WINDOW=10m
PASSWORD_LOGIN_BLOCK_DURATION=15m
GEOIP_V4_DATA_SOURCE=/run/geoip/ip2region_v4.xdb
GEOIP_V6_DATA_SOURCE=/run/geoip/ip2region_v6.xdb

# 短信下发是选择加入的。启用之前必须在运行时注入全部密钥。
SMS_ENABLED=false
SMS_PROVIDER=aliyun
SMS_ENCRYPTION_KEY=
SMS_PHONE_LOOKUP_KEY=
SMS_CODE_PEPPER=
SMS_REQUEST_IP_KEY=
SMS_CAPTCHA_ENABLED=true
SMS_CAPTCHA_CHALLENGE_LIFETIME=120s
SMS_CAPTCHA_PROOF_LIFETIME=120s
SMS_CAPTCHA_ISSUE_IP_LIMIT=10
SMS_ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=宇智汇和东莞科技
SMS_ALIYUN_REGION_ID=cn-hangzhou

# 通知任务。低余额阈值固定为 10 元，不可配置。
NOTIFICATION_FANOUT_BATCH_SIZE=50
NOTIFICATION_FANOUT_FIXED_DELAY=5000
NOTIFICATION_BROADCAST_BATCH_SIZE=50
NOTIFICATION_BROADCAST_FIXED_DELAY=5000
NOTIFICATION_WALLET_DIGEST_CRON=0 0 9 * * *
# 通知短信模板必须先在管理端的运营页面审批并启用之后才能使用。

# 邮件下发是选择加入的。启用之前必须在运行时注入 SMTP 凭证。
EMAIL_ENABLED=false
EMAIL_CODE_PEPPER=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=一加AI中台
EMAIL_REPLY_TO=

# 公网匿名读图（图生图方案 B）：厂商自己去拉客户端上传回来的参考图。
# 不设 GATEWAY_FILES_CONTENT_TOKEN_SECRET 时整个功能关闭（内容端点 404、
# 生图的 image_file_id 返回 501），这是一条需要显式开启的能力。
GATEWAY_FILES_CONTENT_TOKEN_SECRET=
GATEWAY_FILES_CONTENT_TOKEN_TTL=10m

# 该端点的按来源 IP 限流。设计文档把它列为必做项（否则会被当免费图床）：
# docs/operations/图生图方案B-网关中转设计.md:71「必须限流…超限 429」。
# 120 次/分钟覆盖厂商的批量与重试，同时把单 IP 出口压在约 2.4 GiB/分钟内。
GATEWAY_FILES_CONTENT_TOKEN_RATE_LIMIT_PER_IP=120
GATEWAY_FILES_CONTENT_TOKEN_RATE_LIMIT_WINDOW=1m
# 默认 true（fail closed）：Redis 不可用时返回 503 而不是放行。
# 改成 false 会让限流器在 Redis 故障期间完全失效——那是一个**明知的选择**。
GATEWAY_FILES_CONTENT_TOKEN_RATE_LIMIT_FAIL_CLOSED=true
